# Nginx configuration for english.aloeducation.com
#
# Install:
#   sudo cp server-config/alo-english.nginx /etc/nginx/sites-available/alo-english
#   sudo ln -s /etc/nginx/sites-available/alo-english /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl reload nginx
#
# SSL (free via Let's Encrypt):
#   sudo certbot --nginx -d english.aloeducation.com -d www.english.aloeducation.com

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name english.aloeducation.com www.english.aloeducation.com;
    return 301 https://$host$request_uri;
}

# Main server block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name english.aloeducation.com www.english.aloeducation.com;

    # SSL certificates (generated by certbot)
    ssl_certificate /etc/letsencrypt/live/english.aloeducation.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/english.aloeducation.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;

    # Next.js app
    location / {
        proxy_pass http://127.0.0.1:3016;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # WebSocket support for live examiner
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3003;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Static files caching
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3016;
        proxy_cache_valid 200 1y;
        add_header Cache-Control "public, immutable";
    }

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;
    gzip_vary on;

    # File upload size (for audio uploads)
    client_max_body_size 50M;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;
}

# Redirect www to non-www (optional)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.english.aloeducation.com;
    ssl_certificate /etc/letsencrypt/live/english.aloeducation.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/english.aloeducation.com/privkey.pem;
    return 301 https://english.aloeducation.com$request_uri;
}
