# ═══════════════════════════════════════════════════════════════════════
# ALO Education English Test Platform — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to git.

# ─── Database ───────────────────────────────────────────────────────────
# SQLite (default — works anywhere without extra setup).
#
# USE AN ABSOLUTE PATH IN PRODUCTION. The generated standalone server runs
# process.chdir(__dirname), so at runtime the working directory is
# <app>/.next/standalone, NOT the repository root. A relative path like
# file:./db/custom.db then points inside the build output — a directory the
# deploy pipeline replaces on every push — and the site comes back with an
# empty database after each release. src/lib/paths.ts resolves and logs the
# path it actually used, and warns when it lands inside the build output.
#
# Use an ABSOLUTE path in production. The deploy pipeline replaces the
# release directory on every push, so a database inside it does not survive
# a release.
#
# A relative `file:` URL is resolved against the `prisma/` directory, which
# is the same base the Prisma CLI uses — so `prisma migrate deploy` and the
# running application always open the same file. `file:./x.db` therefore
# means `prisma/x.db`.
DATABASE_URL="file:/absolute/path/to/db/production.db"
# Local development only (relative paths resolve under the prisma/ directory):
# DATABASE_URL="file:../db/custom.db"
# For MySQL (optional — use if your host provides it):
# DATABASE_URL="mysql://user:password@localhost:3306/alo_english"

# ─── Authentication ─────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -base64 48
# Must be at least 32 characters
AUTH_SECRET="REPLACE_WITH_RANDOM_32_CHAR_STRING"

# Bcrypt password hashing cost (10-12 recommended, higher = slower but safer)
BCRYPT_COST="12"

# ─── AI Providers (all optional — system works with local rule engine) ──
# Set to "true" to enable AI-powered evaluation
AI_ENABLED="false"

# Groq (fast inference, recommended for evaluation)
GROQ_API_KEY=""
# OpenRouter (multi-model access)
OPENROUTER_API_KEY=""
# Google Gemini
GEMINI_API_KEY=""
# HuggingFace (free tier available)
HUGGINGFACE_API_KEY=""

# AI model to use for evaluation (optional)
AI_MODEL=""

# Request timeout in seconds
AI_REQUEST_TIMEOUT_SECONDS="30"

# Per-provider model overrides (optional). AI_MODEL applies to whichever
# provider is used; these win over it.
# AI_MODEL_GROQ="llama-3.3-70b-versatile"
# AI_MODEL_OPENROUTER="meta-llama/llama-3.3-70b-instruct"
# AI_MODEL_GEMINI="gemini-2.0-flash"
# AI_MODEL_HUGGINGFACE="meta-llama/Llama-3.3-70B-Instruct"

# Point the OpenAI-compatible providers at a self-hosted gateway or an internal
# proxy instead of the public endpoints. Leave unset to use the provider's own
# endpoint. Only set this to a host you trust with learner submissions.
# AI_OPENAI_COMPATIBLE_ENDPOINT="https://llm-gateway.internal/v1/chat/completions"

# ─── Application ────────────────────────────────────────────────────────
NODE_ENV="production"
APP_URL="https://english.aloeducation.com"
APP_PORT="3000"
PORT="3000"
# Bind to all interfaces so the host's reverse proxy can reach the app.
HOSTNAME="0.0.0.0"

# ─── Data directories ───────────────────────────────────────────────────
# Absolute directory for everything that must survive a redeploy: the database,
# uploads and backups. Defaults to the application root when unset. Set this on
# any host that publishes each release into a fresh directory.
# APP_DATA_DIR="/home/<user>/alo-data"
# Override the derived application root (rarely needed).
# APP_ROOT="/home/<user>/public_html"

# Runtime uploads (speaking recordings). Defaults to <APP_DATA_DIR>/upload.
# Do NOT leave this under /tmp — a container restart discards it.
UPLOAD_DIR="./upload"

# ─── Backup ─────────────────────────────────────────────────────────────
BACKUP_DIR="/var/backups/alo-english"

# ─── Seeding (first deploy only) ───────────────────────────────────────
# The core seed creates the first administrator. These are read by
# prisma/seed.mjs and prisma/seed-rbac.ts. Change the password before the
# first run; rotate it afterwards.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="REPLACE_WITH_A_STRONG_ADMIN_PASSWORD"

# ─── Synthetic sample question bank (disposable databases only) ────────
# The sample seeders write unlicensed, short-form development fixtures. They
# refuse to run unless this is exactly "1", NODE_ENV is not "production", and
# DATABASE_URL points at a SQLite file whose name contains ci, test or sample.
# Never set this on a production deployment.
ALLOW_SYNTHETIC_SAMPLE_QUESTIONS="0"

# ─── Listening audio generation (optional) ─────────────────────────────
# Used by `npm run audio:generate` / `npm run audio:verify`. AUDIO_PUBLIC_ORIGIN
# is the public base URL the generated files are served from, and
# AUDIO_ALLOWED_HOSTS is the comma-separated list of hosts the verifier will
# accept media from. AUDIO_VERIFY_CONFIRM must be set to 1 for the verifier
# to write anything back to the database.
AUDIO_PUBLIC_ORIGIN=""
AUDIO_PUBLIC_BASE_URL=""
AUDIO_ALLOWED_HOSTS=""
AUDIO_VERIFY_CONFIRM="0"

# ─── Apache Linkis (optional — computation middleware) ───────────────────
# Disabled by default; app works without Linkis. Enable only if you run a
# separate Linkis cluster (see docs/LINKIS_INTEGRATION.md).
# Upstream: https://github.com/apache/linkis
LINKIS_ENABLED="false"
LINKIS_GATEWAY_URL="http://linkis-gateway:9001"
LINKIS_TOKEN=""
LINKIS_DEFAULT_ENGINE="spark-3.2.1"
LINKIS_TIMEOUT_MS="30000"

# ─── Cron (optional — for daily question generation) ───────────────────
# Set to "true" to enable cron jobs
CRON_ENABLED="false"

# ─── Optional: grammar feedback service (writing practice) ─────────────
# Self-hosted LanguageTool HTTP endpoint, e.g. "http://127.0.0.1:8010".
# Leave unset to disable grammar suggestions entirely. When set, candidate
# writing text is sent to this host — see src/lib/writing/grammar.ts for the
# licence and privacy notes. Requires a separately deployed LanguageTool.
# LANGUAGETOOL_URL="http://127.0.0.1:8010"

# ─── Optional: external analytics dashboard (Umami) ────────────────────
# The built-in analytics bridge stores aggregate counters only and needs no
# configuration. Set these to also send page views to a self-hosted Umami
# instance; see src/lib/integrations/registry.ts and src/lib/analytics/events.ts
# for what the first-party bridge does and does not keep.
# UMAMI_SCRIPT_URL="https://analytics.example.com/script.js"
# UMAMI_WEBSITE_ID="<website id>"

# ─── Communication hub: inbound webhook verification ───────────────────
# A webhook endpoint is a public write path into the CRM, so every provider
# secret below is REQUIRED before that provider's events are accepted. Without
# one, /api/webhooks/<provider> answers 503 rather than accepting unverified
# input. Use at least 16 characters.
# WHATSAPP_APP_SECRET="<meta app secret>"     # WhatsApp Cloud (X-Hub-Signature-256)
# META_APP_SECRET="<meta app secret>"         # Messenger + Instagram
# SMS_WEBHOOK_SECRET="<provider secret>"      # SMS provider (X-ALO-Signature)
# WHATSAPP_VERIFY_TOKEN="<random string>"     # GET subscription handshake
# WHATSAPP_ACCESS_TOKEN="<graph api token>"   # Downloads inbound WhatsApp media (unset = media reported, not collected)
# META_PAGE_ACCESS_TOKEN="<page token>"       # Inbound Messenger / Instagram media, and outbound replies
# WHATSAPP_PHONE_NUMBER_ID="<number id>"      # Sender id for outbound WhatsApp Cloud sends
# ALO_SMS_SEND_URL="https://<provider>/send"  # SMS provider send API (https only; plain http is refused)
# ALO_SMS_ACCESS_TOKEN="<provider token>"     # Credential for the SMS send API
# CRON_SECRET="<random string>"               # Scheduler secret for POST /api/crm/messages/queue/run
                                              # (unset = only an authenticated ADMIN may run the queue)
#
# ─── After-hours assistant (OFF by default) ────────────────────────────
# Answers routine questions outside office hours from a fixed, reviewed set of
# answers, always labelled as automated, and hands anything about admission,
# scholarship, visa, scores, fees or a complaint to a person instead. It never
# sends inside office hours and never contacts a student who declined service
# messages. Leave unset to keep it entirely off; it also needs the outbound
# channel credentials above to actually send.
# ASSISTANT_ENABLED="true"
#
# These hold credentials: keep them in the host's secret storage, never in Git.
# ChannelAccount rows store only a credentialRef pointer, never the secret.
