# ═══════════════════════════════════════════════════════════════════════
# ALO Education English Test Platform — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to git.

# ─── Database ───────────────────────────────────────────────────────────
# SQLite (default — works on any VPS without extra setup)
DATABASE_URL="file:./db/custom.db"
# For MySQL (optional — use if your VPS has MySQL):
# DATABASE_URL="mysql://user:password@localhost:3306/alo_english"

# ─── Authentication ─────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -base64 48
# Must be at least 32 characters
AUTH_SECRET=""
# Separate signing key for session cookies/tokens. Generate with: openssl rand -base64 48
SESSION_SECRET=""
# Used for encrypting provider credentials and other sensitive-at-rest values.
ENCRYPTION_KEY=""
# Bootstrap administrator (used only by the one-shot bootstrap script; never expose client-side)
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Bcrypt password hashing cost (10-12 recommended, higher = slower but safer)
BCRYPT_COST="12"

# ─── AI Providers (all optional — system works with local rule engine) ──
# Set to "true" to enable AI-powered evaluation
AI_ENABLED="false"

# Groq (fast inference, recommended for evaluation)
GROQ_API_KEY=""
# OpenRouter (multi-model access)
OPENROUTER_API_KEY=""
# Google Gemini
GEMINI_API_KEY=""
# HuggingFace (free tier available)
HUGGINGFACE_API_KEY=""

# AI model to use for evaluation (optional)
AI_MODEL=""

# Request timeout in seconds
AI_REQUEST_TIMEOUT_SECONDS="30"

# ─── Application ────────────────────────────────────────────────────────
NODE_ENV="production"
APP_URL="https://english.aloeducation.com"
APP_PORT="3000"
PORT="3000"

# ─── Payments (server-side only; leave unset until provider is provisioned) ─
PAYMENT_PROVIDER=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Email / WhatsApp (server-side only) ────────────────────────────────
EMAIL_PROVIDER=""
SMTP_URL=""
WHATSAPP_PROVIDER=""
WHATSAPP_ACCESS_TOKEN=""

# ─── Object storage (required for production audio/document uploads) ───
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Backup ─────────────────────────────────────────────────────────────
BACKUP_DIR="/var/backups/alo-english"

# ─── Confidence Thresholds (for AI evaluation) ─────────────────────────
LOW_CONFIDENCE_THRESHOLD="0.45"
MEDIUM_CONFIDENCE_THRESHOLD="0.70"

# ─── Cron (optional — for daily question generation) ───────────────────
# Set to "true" to enable cron jobs
CRON_ENABLED="false"
