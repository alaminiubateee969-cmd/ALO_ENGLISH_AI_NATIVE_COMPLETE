// ALO English Education Web_CRM — Prisma Schema
// MariaDB / MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  EXAMINER
  STUDENT
  AMBASSADOR
  EMPLOYEE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  name          String
  passwordHash  String
  role          Role      @default(STUDENT)
  status        String    @default("active") // active | suspended | inactive
  image         String?
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  student       Student?
  teacher       Teacher?
  examiner      Examiner?
  ambassador    Ambassador?
  employee      Employee?
  leads         Lead[]      @relation("LeadOwner")
  enrollments   Enrollment[]
  payments      Payment[]
  vouchers      Voucher[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== STUDENT CRM ====================

model Student {
  id              String   @id @default(cuid())
  userId          String   @unique
  studentCode     String   @unique
  aloStudentId    String?
  aloLeadId       String?
  aloApplicationId String?
  targetCountry   String?
  targetCourse    String?
  targetScore     String?
  currentLevel    String?
  profileStatus   String   @default("incomplete")
  eligibilityStatus String @default("unknown")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]
  examAttempts    ExamAttempt[]
  results         ExamResult[]
  certificates    Certificate[]
  studyPlans      StudyPlan[]
  attendances     Attendance[]
  assignments     AssignmentSubmission[]
  vouchers        Voucher[]
  messages        Message[]     @relation("MessageRecipient")
  notifications   Notification[]

  @@index([aloStudentId])
  @@index([profileStatus])
}

model Teacher {
  id          String   @id @default(cuid())
  userId      String   @unique
  teacherCode String   @unique
  bio         String?
  subjects    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes     Class[]
  assignments Assignment[]

  @@index([teacherCode])
}

model Examiner {
  id           String   @id @default(cuid())
  userId       String   @unique
  examinerCode String   @unique
  specializations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  writingReviews WritingReview[]
  speakingReviews SpeakingReview[]

  @@index([examinerCode])
}

model Ambassador {
  id             String   @id @default(cuid())
  userId         String   @unique
  ambassadorCode String   @unique
  referralCode   String   @unique
  organization   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals   Referral[]

  @@index([ambassadorCode])
}

model Employee {
  id          String   @id @default(cuid())
  userId      String   @unique
  employeeCode String  @unique
  department  String?
  position    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeCode])
}

// ==================== COURSES ====================

model Course {
  id          String   @id @default(cuid())
  courseCode  String   @unique
  title       String
  slug        String   @unique
  description String   @db.Text
  category    String   // ielts | pte | toefl | duolingo | oietc | spoken | academic | business | grammar | vocabulary
  level       String   @default("all") // beginner | intermediate | advanced | all
  duration    Int      @default(40) // hours
  price       Decimal  @default(0) @db.Decimal(10, 2)
  currency    String   @default("BDT")
  imageUrl    String?
  syllabus    String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  classes     Class[]
  assignments Assignment[]
  resources   LearningResource[]

  @@index([category])
  @@index([isActive])
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  status     String   @default("active") // active | completed | cancelled
  progress   Int      @default(0) // 0-100
  enrolledAt DateTime @default(now())
  completedAt DateTime?

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@unique([studentId, courseId])
  @@index([status])
}

// ==================== EXAMS & QUESTION BANK ====================

model ExamType {
  id            String   @id @default(cuid())
  code          String   @unique // IELTS | PTE | TOEFL | DUOLINGO | OIETC | ELLT | IELTS_UKVI
  name          String
  slug          String   @unique
  description   String?  @db.Text
  duration      Int      // total minutes
  scoreScale    String
  styleLabel    String   // "IELTS-style practice test"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sections      ExamSection[]
  questions     Question[]
  mockTests     MockTest[]
  attempts      ExamAttempt[]

  @@index([isActive])
}

model ExamSection {
  id          String   @id @default(cuid())
  examTypeId  String
  name        String   // Listening | Reading | Writing | Speaking
  description String?
  duration    Int      // minutes
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  examType    ExamType @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  questions   Question[]

  @@index([examTypeId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE_NOT_GIVEN
  FILL_BLANK
  SHORT_ANSWER
  ESSAY
  SPEAKING
  MATCHING
  REORDER
  NUMERIC
  DESCRIPTIVE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  ADVANCED
}

model Question {
  id            String       @id @default(cuid())
  questionCode  String       @unique
  examTypeId    String
  sectionId     String
  type          QuestionType
  difficulty    Difficulty   @default(MEDIUM)
  prompt        String       @db.Text
  passage       String?      @db.LongText
  audioScript   String?      @db.LongText
  imagePrompt   String?
  options       Json?        // string[] for MCQ
  correctAnswer Json?        // number (MCQ index) | string (fill blank) | number[] (multi)
  correctIndices Int[]?
  numericAnswer  Float?
  modelAnswer   String?      @db.LongText
  explanation   String?      @db.Text
  scoreValue    Float        @default(1.0)
  tags          String[]    @default([])
  isActive      Boolean      @default(true)
  isPublished   Boolean      @default(false)
  version       Int          @default(1)
  createdById   String?
  reviewedById  String?
  approvedById  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  examType      ExamType     @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  section       ExamSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers       ExamAnswer[]

  @@index([examTypeId, sectionId])
  @@index([difficulty])
  @@index([isActive, isPublished])
}

model MockTest {
  id          String   @id @default(cuid())
  mockCode    String   @unique
  examTypeId  String
  title       String
  description String?  @db.Text
  difficulty  Difficulty @default(MEDIUM)
  duration    Int      // minutes
  totalQuestions Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  examType    ExamType     @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  attempts    ExamAttempt[]

  @@index([examTypeId])
  @@index([isPublished])
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  EXPIRED
  CANCELLED
}

model ExamAttempt {
  id            String        @id @default(cuid())
  attemptCode   String        @unique
  studentId     String
  mockTestId    String?
  examTypeId    String
  status        AttemptStatus @default(NOT_STARTED)
  mode          String        @default("quick") // quick | full
  startedAt     DateTime?
  submittedAt   DateTime?
  expiresAt     DateTime?
  timeUsedSec   Int           @default(0)
  overallScore  Float?
  bandEstimate  String?
  cefrEstimate  String?
  isFree        Boolean       @default(true)
  source        String        @default("web")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mockTest      MockTest?     @relation(fields: [mockTestId], references: [id], onDelete: SetNull)
  examType      ExamType      @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  answers       ExamAnswer[]
  result        ExamResult?

  @@index([studentId])
  @@index([status])
  @@index([examTypeId])
}

model ExamAnswer {
  id           String   @id @default(cuid())
  attemptId    String
  questionId   String
  answerText   String?  @db.LongText
  answerJson   Json?
  audioPath    String?
  isCorrect    Boolean?
  scoreAwarded Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attempt      ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model ExamResult {
  id            String   @id @default(cuid())
  resultCode    String   @unique
  attemptId     String   @unique
  studentId     String
  examTypeId    String
  overallScore  Float
  listeningScore Float?
  readingScore  Float?
  writingScore  Float?
  speakingScore Float?
  bandEstimate  String
  cefrEstimate  String
  strengths     String?  @db.Text
  weaknesses    String?  @db.Text
  recommendation String? @db.Text
  pdfPath       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempt       ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examType      ExamType    @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  certificate   Certificate?

  @@index([studentId])
}

// ==================== WRITING & SPEAKING REVIEWS ====================

model WritingReview {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  examinerId    String
  answerText    String   @db.LongText
  wordCount     Int
  taskScore     Float?
  coherenceScore Float?
  vocabularyScore Float?
  grammarScore  Float?
  feedback      String?  @db.Text
  status        String   @default("pending") // pending | in_review | completed | returned
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?

  examiner      Examiner @relation(fields: [examinerId], references: [id], onDelete: Cascade)

  @@index([examinerId])
  @@index([status])
}

model SpeakingReview {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  examinerId    String
  audioPath     String
  durationSec   Int
  fluencyScore  Float?
  pronunciationScore Float?
  grammarScore  Float?
  lexicalScore  Float?
  coherenceScore Float?
  confidenceScore Float?
  feedback      String?  @db.Text
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?

  examiner      Examiner @relation(fields: [examinerId], references: [id], onDelete: Cascade)

  @@index([examinerId])
  @@index([status])
}

// ==================== CERTIFICATES ====================

model Certificate {
  id               String   @id @default(cuid())
  certificateCode  String   @unique
  studentId        String
  resultId         String?  @unique
  studentName      String
  examName         String
  overallScore     String
  bandEstimate     String?
  cefrLevel        String?
  certificateType  String   @default("completion")
  verificationHash String   @unique
  pdfPath          String?
  emailSent        Boolean  @default(false)
  crmSynced        Boolean  @default(false)
  status           String   @default("issued") // issued | revoked | replaced
  issuedAt         DateTime @default(now())

  student          Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  result           ExamResult? @relation(fields: [resultId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([verificationHash])
}

// ==================== CRM: LEADS & ADMISSIONS ====================

model Lead {
  id          String   @id @default(cuid())
  leadCode    String   @unique
  name        String
  email       String?
  phone       String?
  source      String   @default("website")
  interest    String?  // exam type or course
  targetCountry String?
  status      String   @default("new") // new | contacted | qualified | enrolled | lost
  notes       String?  @db.Text
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User?    @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([source])
}

// ==================== PAYMENTS & VOUCHERS ====================

model Payment {
  id             String   @id @default(cuid())
  paymentCode    String   @unique
  studentId      String?
  enrollmentId   String?
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("BDT")
  method         String?  // bkash | nagad | sslcommerz | stripe | bank
  status         String   @default("pending") // pending | paid | failed | refunded
  transactionId  String?
  paidAt         DateTime?
  createdAt      DateTime @default(now())

  enrollment     Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Voucher {
  id           String    @id @default(cuid())
  voucherCode  String    @unique
  voucherType  String    // IELTS_MOCK | PTE_MOCK | GENERAL | SPEAKING | WRITING
  studentId    String?
  usageLimit   Int       @default(1)
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  status       String    @default("available") // available | used | expired | cancelled
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([voucherCode])
  @@index([status])
}

// ==================== CLASSES & SCHEDULES ====================

model Class {
  id          String   @id @default(cuid())
  courseId    String
  teacherId   String
  name        String
  room        String?
  capacity    Int      @default(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schedules   Schedule[]
  attendances Attendance[]

  @@index([courseId])
  @@index([teacherId])
}

model Schedule {
  id        String   @id @default(cuid())
  classId   String
  dayOfWeek Int      // 0=Sun, 6=Sat
  startTime String   // HH:mm
  endTime   String   // HH:mm
  createdAt DateTime @default(now())

  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model Attendance {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  date      DateTime
  status    String   @default("present") // present | absent | late | excused
  notes     String?
  createdAt DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId, date])
  @@index([studentId])
}

// ==================== ASSIGNMENTS & HOMEWORK ====================

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  teacherId   String
  title       String
  description String?  @db.Text
  dueDate     DateTime
  maxScore    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId])
  @@index([dueDate])
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  content      String   @db.LongText
  filePath     String?
  score        Int?
  feedback     String?  @db.Text
  status       String   @default("submitted") // submitted | graded | returned
  submittedAt  DateTime @default(now())
  gradedAt     DateTime?

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

// ==================== STUDY PLANS & RESOURCES ====================

model StudyPlan {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  description String?  @db.Text
  targetDate  DateTime?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model LearningResource {
  id          String   @id @default(cuid())
  courseId    String?
  title       String
  type        String   // pdf | video | audio | link | document
  url         String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([courseId])
}

// ==================== REFERRALS ====================

model Referral {
  id              String   @id @default(cuid())
  ambassadorId    String
  leadName        String
  leadEmail       String?
  leadPhone       String?
  status          String   @default("registered") // registered | converted | lost
  commissionStatus String  @default("pending") // pending | paid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ambassador      Ambassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)

  @@index([ambassadorId])
  @@index([status])
}

// ==================== MESSAGES & NOTIFICATIONS ====================

model Message {
  id          String   @id @default(cuid())
  senderId    String?
  recipientId String
  subject     String
  body        String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient   Student  @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([isRead])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @db.Text
  type      String   @default("info") // info | success | warning | error
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ==================== SETTINGS ====================

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  isSecret Boolean @default(false)
  updatedAt DateTime @updatedAt
}
