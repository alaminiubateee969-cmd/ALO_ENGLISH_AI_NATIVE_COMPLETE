# ALO English — Environment Configuration
#
# This file is tracked on purpose, to provide safe NON-SECRET defaults so the
# application boots in a fresh checkout and during a host build. Production
# values are set in the host's environment variables panel (hPanel → Node.js →
# Configuration → Environment Variables).
#
# Precedence: a real environment variable always wins over this file. Next.js
# loads .env WITHOUT overwriting values already present in process.env, so
# anything set in the panel takes effect and nothing here can shadow it.
#
# NEVER put a real secret in this file. It is in the repository.

# Relative on purpose: src/lib/paths.ts resolves a relative SQLite path against
# the application root (not the working directory, which the generated
# standalone server moves to .next/standalone). In production set an ABSOLUTE
# DATABASE_URL in the panel, for example:
#   DATABASE_URL="file:/home/<user>/alo-data/db/production.db"
DATABASE_URL="file:./db/production.db"

# Placeholder only. Generate a real one with: openssl rand -base64 48
AUTH_SECRET="change-me-in-hostinger-panel-must-be-32-chars-minimum-xxxxxxxxxxxx"

NODE_ENV="production"
APP_URL="https://english.aloeducation.com"
APP_PORT="3000"
PORT="3000"
# Bind to all interfaces so the host's reverse proxy can reach the app.
HOSTNAME="0.0.0.0"

# Absolute directory for data that must survive a redeploy (database, uploads,
# backups). Leave unset in development; set it in the panel in production.
# APP_DATA_DIR="/home/<user>/alo-data"

BCRYPT_COST="12"
AI_ENABLED="false"
LOW_CONFIDENCE_THRESHOLD="0.45"
MEDIUM_CONFIDENCE_THRESHOLD="0.70"
