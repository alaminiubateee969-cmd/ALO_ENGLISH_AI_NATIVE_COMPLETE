// Prisma schema for the ALO Education Platform.
// Full CRM + Exam Platform + Communication + Documents.
// Database: SQLite (single-server deployment).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══ Authentication & RBAC ════════════════════════════════════════════

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  name         String?
  passwordHash String
  role         String    @default("STUDENT") // SUPER_ADMIN|ADMIN|HR_MANAGER|BRANCH_MANAGER|MARKETING_MANAGER|COUNSELOR|APPLICATION_TEAM|VISA_OFFICER|FINANCE|FRONT_DESK|SUPPORT|PARTNER|STUDENT
  status       String    @default("ACTIVE")  // ACTIVE|SUSPENDED|PENDING|OFFBOARDED
  branchId     String?
  departmentId String?
  supervisorId String?
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch       Branch?       @relation(fields: [branchId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  supervisor   User?         @relation("Supervisor", fields: [supervisorId], references: [id])
  subordinates User[]        @relation("Supervisor")
  leads        Lead[]        @relation("LeadCounselor")
  students     Student[]     @relation("StudentCounselor")
  studentProfile Student?    @relation("StudentUser")
  partnerProfile Partner?    @relation("PartnerUser")
  applications Application[] @relation("AppAssignee")
  tasks        Task[]        @relation("TaskAssignee")
  messages     Message[]     @relation("MessageSender")
  auditLogs    AuditLog[]
  passwordResets PasswordReset[]
  notifications Notification[]

  attempts     Attempt[]
  scores       Score[]

  // Phase 1: RBAC + Multi-tenancy relations
  teamMembers  TeamMember[]
  sessions     Session[]

  @@index([role])
  @@index([status])
  @@index([branchId])
  @@index([departmentId])
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  phone     String?
  email     String?
  timezone  String   @default("Asia/Dhaka")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users       User[]
  departments Department[]
  leads       Lead[]
}

model Department {
  id        String   @id @default(cuid())
  name      String
  branchId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  users    User[]
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ═══ CRM Core: Leads, Students, Partners ══════════════════════════════

model Lead {
  id            String    @id @default(cuid())
  name          String
  email         String?
  phone         String?
  source        String    @default("WEBSITE") // WEBSITE|WHATSAPP|FACEBOOK|INSTAGRAM|EMAIL|PHONE|REFERRAL|EVENT
  status        String    @default("NEW")     // NEW|CONTACTED|QUALIFIED|CONVERTED|LOST
  country       String?
  courseInterest String?
  intake        String?
  budgetRange   String?
  englishStatus String?
  branchId      String?
  counselorId   String?
  partnerId     String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch     Branch?    @relation(fields: [branchId], references: [id])
  counselor  User?      @relation("LeadCounselor", fields: [counselorId], references: [id])
  partner    Partner?   @relation(fields: [partnerId], references: [id])
  student    Student?
  tasks      Task[]
  messages   Message[]

  @@index([status])
  @@index([counselorId])
  @@index([branchId])
  @@index([source])
}

model Student {
  id            String    @id @default(cuid())
  userId        String?   @unique
  leadId        String?   @unique
  name          String
  email         String?
  phone         String?
  dateOfBirth   DateTime?
  nationality   String?
  passportNumber String?
  address       String?
  city          String?
  country       String?
  status        String    @default("ACTIVE") // ACTIVE|INACTIVE|GRADUATED|WITHDRAWN
  branchId      String?
  counselorId   String?
  partnerId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User?      @relation("StudentUser", fields: [userId], references: [id])
  lead      Lead?      @relation(fields: [leadId], references: [id])
  counselor User?      @relation("StudentCounselor", fields: [counselorId], references: [id])
  partner   Partner?   @relation(fields: [partnerId], references: [id])
  applications Application[]
  documents  Document[]
  commissions Commission[]
  tasks      Task[]
  messages   Message[]

  @@index([counselorId])
  @@index([status])
}

model Partner {
  id            String    @id @default(cuid())
  userId        String?   @unique
  organizationName String
  contactName   String
  email         String?
  phone         String?
  address       String?
  status        String    @default("ACTIVE")
  commissionRate Float    @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User?      @relation("PartnerUser", fields: [userId], references: [id])
  leads     Lead[]
  students  Student[]
  commissions Commission[]

  @@index([status])
}

model Commission {
  id          String   @id @default(cuid())
  partnerId   String
  studentId   String?
  amount      Float
  status      String   @default("PENDING") // PENDING|PAID|CANCELLED
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  student   Student? @relation(fields: [studentId], references: [id])

  @@index([partnerId])
  @@index([status])
}

// ═══ Education Catalog ════════════════════════════════════════════════

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  flag      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  universities University[]
}

model University {
  id          String   @id @default(cuid())
  name        String
  countryId   String
  city        String?
  website     String?
  description String?
  logo        String?
  isActive    Boolean  @default(true)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country   Country  @relation(fields: [countryId], references: [id])
  courses   Course[]
  scholarships Scholarship[]

  @@index([countryId])
  @@index([isPublished])
}

model Course {
  id            String   @id @default(cuid())
  universityId  String
  name          String
  level         String?  // BACHELOR|MASTER|PHD|DIPLOMA|CERTIFICATE
  duration      String?
  tuitionFee    Float?
  currency      String   @default("USD")
  entryRequirements String?
  description   String?
  isActive      Boolean  @default(true)
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  university   University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([universityId])
  @@index([isPublished])
}

model Scholarship {
  id            String   @id @default(cuid())
  universityId  String
  name          String
  amount        Float?
  currency      String   @default("USD")
  eligibility   String?
  deadline      DateTime?
  description   String?
  isActive      Boolean  @default(true)
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())

  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
}

// ═══ Applications ═════════════════════════════════════════════════════

model Application {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String
  intake      String?
  status      String    @default("DRAFT") // DRAFT|SUBMITTED|UNDER_REVIEW|OFFERED|ACCEPTED|CAS_ISSUED|VISA_APPLIED|VISA_APPROVED|REJECTED|DEFERRED|COMPLETED
  assignedTo  String?
  notes       String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id])
  assignee   User?      @relation("AppAssignee", fields: [assignedTo], references: [id])
  documents  Document[]
  tasks      Task[]

  @@index([studentId])
  @@index([status])
  @@index([assignedTo])
}

// ═══ Documents & OCR ═══════════════════════════════════════════════════

model Document {
  id           String   @id @default(cuid())
  studentId    String
  applicationId String?
  type         String   // PASSPORT|NID|BIRTH_CERT|IELTS|PTE|TOEFL|DUOLINGO|TRANSCRIPT|CERTIFICATE|CV|SOP|RECOMMENDATION|BANK_STATEMENT|SPONSOR|PHOTO|OFFER_LETTER|CAS|COE|I20|VISA|TUITION_RECEIPT|APPLICATION_FORM
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  fileHash     String?
  uploadedBy   String?
  ocrStatus    String   @default("PENDING") // PENDING|PROCESSING|COMPLETED|FAILED|REVIEW_NEEDED
  ocrData      String?  // JSON string of extracted fields
  ocrConfidence Float?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id])

  @@index([studentId])
  @@index([type])
  @@index([ocrStatus])
}

// ═══ Communications ════════════════════════════════════════════════════

model Message {
  id           String   @id @default(cuid())
  channel      String   // WHATSAPP|FACEBOOK|INSTAGRAM|EMAIL|SMS|WEBCHAT|PORTAL|INTERNAL
  direction    String   // INBOUND|OUTBOUND
  senderId     String?
  senderName   String?
  senderHandle String?  // phone number / email / social handle
  recipientId  String?
  recipientName String?
  recipientHandle String?
  body         String
  attachments  String?  // JSON array of file paths
  status       String   @default("SENT") // PENDING|SENT|DELIVERED|READ|FAILED
  leadId       String?
  studentId    String?
  partnerId    String?
  applicationId String?
  internalNote String?
  aiSummary    String?
  readAt       DateTime?
  createdAt    DateTime @default(now())

  sender      User?     @relation("MessageSender", fields: [senderId], references: [id])
  lead        Lead?     @relation(fields: [leadId], references: [id])
  student     Student?  @relation(fields: [studentId], references: [id])

  @@index([channel])
  @@index([leadId])
  @@index([studentId])
  @@index([createdAt])
}

// ═══ Tasks, Appointments, Timeline ════════════════════════════════════

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("PENDING") // PENDING|IN_PROGRESS|COMPLETED|CANCELLED
  priority    String    @default("MEDIUM")  // LOW|MEDIUM|HIGH|URGENT
  dueDate     DateTime?
  assigneeId  String?
  leadId      String?
  studentId   String?
  applicationId String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  lead        Lead?         @relation(fields: [leadId], references: [id])
  student     Student?      @relation(fields: [studentId], references: [id])
  application Application?  @relation(fields: [applicationId], references: [id])

  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
}

model Appointment {
  id          String   @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  studentId   String?
  leadId      String?
  assigneeId  String?
  location    String?
  status      String   @default("SCHEDULED") // SCHEDULED|COMPLETED|CANCELLED|NO_SHOW
  createdAt   DateTime @default(now())

  @@index([startTime])
  @@index([assigneeId])
}

model TimelineEntry {
  id          String   @id @default(cuid())
  entityType  String   // LEAD|STUDENT|APPLICATION
  entityId    String
  action      String
  description String?
  metadata    String?  // JSON
  userId      String?
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

// ═══ Notifications ═════════════════════════════════════════════════════

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("INFO") // INFO|SUCCESS|WARNING|ERROR
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

// ═══ Audit & Settings ══════════════════════════════════════════════════

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  ipAddress String?
  metadata  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ═══ Exam Platform ════════════════════════════════════════════════════

model ExamType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  practiceSets PracticeSet[]
}

model PracticeSet {
  id          String   @id @default(cuid())
  examTypeId  String
  title       String
  description String?
  durationMin Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  examType    ExamType  @relation(fields: [examTypeId], references: [id], onDelete: Cascade)
  attempts    Attempt[]
  questions   Question[]

  @@index([examTypeId])
}

model Attempt {
  id          String    @id @default(cuid())
  userId      String
  practiceSetId String
  status      String    @default("IN_PROGRESS")
  startedAt   DateTime  @default(now())
  /// Server-authoritative deadline. Derived from the practice set duration at
  /// start time; the browser clock is never trusted.
  expiresAt   DateTime?
  /// Snapshot of the practice set duration so later edits cannot change a
  /// running attempt's deadline.
  durationMin Int?
  /// 1-based count of attempts this user has made on this practice set.
  attemptNumber Int     @default(1)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSet PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  score       Score?
  /// The question set frozen at attempt start. Reused on every resume so a
  /// refresh or a different device always yields the same questions.
  attemptQuestions AttemptQuestion[]
  answers     AttemptAnswer[]

  @@index([userId])
  @@index([status])
  @@index([userId, practiceSetId])
  @@index([expiresAt])
}

/// Join table freezing the exact question set (and order) for one attempt.
model AttemptQuestion {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  order      Int      @default(0)
  section    String
  createdAt  DateTime @default(now())

  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

/// Server-side answer store. Powers autosave, refresh recovery and
/// submission grading — grading never trusts a client-side answer set.
model AttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  answer     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model Score {
  id           String   @id @default(cuid())
  attemptId    String   @unique
  userId       String
  overall      Float
  listening    Float?
  reading      Float?
  writing      Float?
  speaking     Float?
  confidence   Float    @default(0.0)
  providerUsed String   @default("local_rule_engine")
  fallbackUsed Boolean  @default(false)
  createdAt    DateTime @default(now())

  attempt      Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══ Exam Questions ════════════════════════════════════════════════════

model Question {
  id            String   @id @default(cuid())
  practiceSetId String
  section       String   // LISTENING|READING|WRITING|SPEAKING
  type          String   // MULTIPLE_CHOICE|TRUE_FALSE_NOT_GIVEN|MATCHING|FILL_BLANK|LABELING|SHORT_ANSWER|ESSAY|SPEAKING|SENTENCE_COMPLETION|SUMMARY_COMPLETION|CHART_DESCRIPTION
  prompt        String
  passage       String?  // Reading passage or audio transcript
  audioUrl      String?  // Audio file for listening (optional)
  options       String?  // JSON array of options for MC/matching
  correctAnswer String?  // For fill-blank / short answer
  correctIndex  Int?     // For MC: index of correct option
  correctIndices String? // JSON array for matching/labeling
  wordLimit     Int?     // For writing tasks
  imageUrl      String?  // For chart/diagram/map questions
  points        Int      @default(1)
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  practiceSet   PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  attemptQuestions AttemptQuestion[]

  @@index([practiceSetId])
  @@index([section])
}

// ═══ Free Quota + Payment ═════════════════════════════════════════════

model FreeQuota {
  id           String   @id @default(cuid())
  userId       String   @unique
  attemptsUsed Int      @default(0)
  attemptsLimit Int     @default(3)
  isAloStudent Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  amount       Float
  currency     String   @default("USD")
  status       String   @default("PENDING") // PENDING|COMPLETED|FAILED|REFUNDED
  method       String   @default("MANUAL")
  attemptsPaid Int      @default(1)
  txnId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model DailyQuestionSet {
  id            String   @id @default(cuid())
  examTypeCode  String
  date          String   // YYYY-MM-DD
  practiceSetId String
  isGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([examTypeCode, date])
  @@index([examTypeCode, date])
}

// ═══ Student Learning Memory ═════════════════════════════════════════

model LearningMemory {
  id           String   @id @default(cuid())
  userId       String
  weaknessArea String   // e.g. "articles", "prepositions", "pronunciation"
  weaknessType String   // GRAMMAR|VOCABULARY|PRONUNCIATION|FLUENCY|COHERENCE
  occurrences  Int      @default(1)
  lastSeenAt   DateTime @default(now())
  resolvedAt   DateTime?
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, weaknessArea])
  @@index([userId])
  @@index([weaknessType])
}

// ═══ Agent Learning & Self-Development ═════════════════════════════════

model AgentLearning {
  id            String   @id @default(cuid())
  agentId       String   // e.g. "examiner-02", "writing-eval-agent"
  agentType     String   // EXAMINER|EVALUATOR|QUESTION_GENERATOR|ORCHESTRATOR
  learnDate     DateTime @default(now())
  examTypeCode  String?  // IELTS|TOEFL|PTE|...
  observation   String   // What the agent learned (e.g. "Students struggle with Part 2 long turn")
  insight       String?  // Extracted insight (e.g. "Add more preparation time prompts")
  metricType    String?  // ACCURACY|FLUENCY|CONFIDENCE|WEAKNESS_PATTERN
  metricValue   Float?
  sampleSize    Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([agentId, learnDate])
  @@index([agentType])
  @@index([examTypeCode])
}

model AgentEvolution {
  id             String   @id @default(cuid())
  agentId        String
  version        Int      @default(1)
  changeType     String   // PROMPT_UPDATE|RULE_ADD|PARAMETER_TUNING|NEW_SPECIALIST
  description    String
  triggerMetric  String?  // What metric triggered this evolution
  triggerValue   Float?
  previousConfig String?  // JSON of previous config
  newConfig      String?  // JSON of new config
  approvedBy     String?  // "auto" or user id
  deployedAt     DateTime?
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([agentId, version])
  @@index([isActive])
}

model ExamAnalytics {
  id             String   @id @default(cuid())
  examTypeCode   String
  questionId     String?
  section        String?  // LISTENING|READING|WRITING|SPEAKING
  totalAttempts  Int      @default(0)
  correctCount   Int      @default(0)
  avgScore       Float    @default(0)
  avgDurationSec Float    @default(0)
  difficulty     Float    @default(0.5) // 0=easy, 1=hard
  discrimination Float    @default(0)   // how well it distinguishes strong/weak
  lastUpdated    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([examTypeCode, questionId])
  @@index([examTypeCode])
  @@index([section])
}

model AgentSpecialist {
  id             String   @id @default(cuid())
  name           String
  specialization String   // e.g. "Bengali-Article-Dropping", "Part2-Long-Turn-Coaching"
  parentAgentId  String?  // Which agent created this specialist
  examTypeCode   String?  // Which exam type this specialist handles
  config         String   // JSON: prompt, voice, focus areas
  performance    Float    @default(0.5) // 0-1, rolling average
  totalExams     Int      @default(0)
  isActive       Boolean  @default(true)
  createdById    String?  // "auto" or user id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([specialization])
  @@index([examTypeCode])
  @@index([isActive])
}

// ═══ RAG Knowledge Base (ExamCite-style) ═══════════════════════════════

model StudyMaterial {
  id            String   @id @default(cuid())
  title         String
  description   String?
  category      String   // IELTS|TOEFL|PTE|GENERAL|GRAMMAR|VOCABULARY
  sourceType    String   // TEXT|URL|FILE
  content       String   // The full text content for RAG
  chunkCount    Int      @default(0)
  uploadedById  String?  // User who uploaded (null = system)
  isPublic      Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isPublic, isActive])
}

model ChatSession {
  id            String   @id @default(cuid())
  userId        String?
  sessionId     String   @unique // anonymous session ID (for no-signup use)
  materialId    String?
  messages      String   // JSON array of {role, content, timestamp}
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}

// ═══ Phase 1: RBAC + Multi-Tenancy + Session Management ═════════════════

model Team {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  status      String      @default("ACTIVE") // ACTIVE|SUSPENDED|ARCHIVED
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  members     TeamMember[]
  roles       Role[]

  @@index([status])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false) // System roles can't be deleted
  teamId      String?          // Null = global role, non-null = team-specific
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  team        Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     TeamMember[]

  @@index([teamId])
  @@index([slug])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "leads.view", "users.manage"
  description String?
  category    String           // e.g. "leads", "users", "meta", "settings"

  roles       RolePermission[]

  @@index([category])
  @@index([key])
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ip        String?
  userAgent String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([token])
}
